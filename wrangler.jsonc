{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "connectwise-mcp-v2",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_PRODUCTION_KV_ID",
      "preview_id": "REPLACE_WITH_PREVIEW_KV_ID",
    },
  ],
  "vars": {
    "MCP_CANONICAL_URL": "https://mcp.example.com/mcp",
    "ENTRA_TENANT_ID": "REPLACE_WITH_TENANT_ID",
    "ENTRA_CLIENT_ID": "REPLACE_WITH_CLIENT_ID",
    "ALLOWED_GROUP_IDS": "[]",
    "ALLOWED_APP_ROLES": "[]",
    "ALLOWED_CLIENT_REDIRECT_URIS": "[]",
    "CONNECTWISE_ALLOWED_ORIGINS": "[]",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
