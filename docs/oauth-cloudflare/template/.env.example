# ============================================================================
# MCP OAuth Server Configuration
# Copy this file to .env and fill in your values
# ============================================================================

# ----------------------------------------------------------------------------
# Auth0 Configuration
# Get these from: https://manage.auth0.com/dashboard
# ----------------------------------------------------------------------------
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id-here
AUTH0_CLIENT_SECRET=your-client-secret-here
AUTH0_AUDIENCE=https://mcp.yourdomain.com

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
SERVER_URL=https://mcp.yourdomain.com
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-generated-secret-key-here

# ----------------------------------------------------------------------------
# ConnectWise API Configuration
# Get these from ConnectWise Manage: System > Members > API Members
# ----------------------------------------------------------------------------
CW_COMPANY_ID=your_company
CW_PUBLIC_KEY=your_public_key
CW_PRIVATE_KEY=your_private_key
CW_CLIENT_ID=your_client_id
CW_API_URL=https://api-na.myconnectwise.net/v4_6_release/apis/3.0

# ----------------------------------------------------------------------------
# Cloudflare Tunnel Configuration
# Get from: https://one.dash.cloudflare.com/ > Access > Tunnels
# ----------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
