# Required: static bearer token for MCP requests (minimum 32 ASCII bytes)
MCP_STATIC_TOKEN=replace-with-strong-token-at-least-32-bytes

# Local development base URL. Approved rollback operators must set the reviewed
# canonical URL through the controlled rollback procedure.
SERVER_URL=http://127.0.0.1:8000

# Resource URL used in OAuth (must match MCP client 'resource' param)
MCP_RESOURCE_URL=http://127.0.0.1:8000

# JWT secret for locally-issued OAuth tokens (minimum 32 ASCII bytes)
JWT_SECRET_KEY=replace-with-strong-secret-at-least-32-bytes

# ConnectWise API config
CONNECTWISE_API_URL=https://na.myconnectwise.net/v4_6_release/apis/3.0
CONNECTWISE_COMPANY_ID=your_company_id
CONNECTWISE_PUBLIC_KEY=your_public_key
CONNECTWISE_PRIVATE_KEY=your_private_key
CONNECTWISE_AUTH_PREFIX=yourprefix+

# Cloudflare Tunnel (leave empty for local development; set only during an
# approved, time-bounded rollback procedure)
CLOUDFLARE_TUNNEL_TOKEN=

# Azure AD (SSO)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional: if your Azure tokens use a custom audience
AZURE_AUDIENCE=
# Optional: scopes for Azure login
AZURE_SCOPES=openid profile email
