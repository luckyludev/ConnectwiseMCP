# Required: static bearer token for all requests
MCP_STATIC_TOKEN=replace-with-strong-token

# Public base URL of this server
SERVER_URL=https://connectwisemcp.funcshun.com

# Resource URL used in OAuth (must match MCP client 'resource' param)
MCP_RESOURCE_URL=https://connectwisemcp.funcshun.com

# JWT secret for locally-issued OAuth tokens
JWT_SECRET_KEY=replace-with-strong-secret

# ConnectWise API config
CONNECTWISE_API_URL=https://na.myconnectwise.net/v4_6_release/apis/3.0
CONNECTWISE_COMPANY_ID=your_company_id
CONNECTWISE_PUBLIC_KEY=your_public_key
CONNECTWISE_PRIVATE_KEY=your_private_key
CONNECTWISE_AUTH_PREFIX=yourprefix+

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# Azure AD (SSO)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional: if your Azure tokens use a custom audience
AZURE_AUDIENCE=
# Optional: scopes for Azure login
AZURE_SCOPES=openid profile email
