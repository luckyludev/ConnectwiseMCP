# Required: static bearer token for all requests
MCP_STATIC_TOKEN=replace-with-strong-token

# ConnectWise API config
CONNECTWISE_API_URL=https://na.myconnectwise.net/v4_6_release/apis/3.0
CONNECTWISE_COMPANY_ID=your_company_id
CONNECTWISE_PUBLIC_KEY=your_public_key
CONNECTWISE_PRIVATE_KEY=your_private_key
CONNECTWISE_AUTH_PREFIX=yourprefix+

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# Azure AD (SSO) placeholders - fill later
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_AUDIENCE=
